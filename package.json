{
  "name": "biocrust",
  "private": true,
  "version": "1.0.4",
  "description": "Biocrust Explorer Game",
  "author": "w-3-n",
  "repository": {
    "type": "git",
    "url": "https://github.com/w-3-n/biocrust.git"
  },
  "main": "main.cjs",
  "build": {
    "appId": "com.biocrust.game",
    "productName": "Biocrust",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs"
    ],
    "mac": {
      "target": "dmg",
      "identity": null
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "oxlint": "^1.75.0",
    "vite": "^5.4.21"
  },
  "overrides": {
    "@noble/hashes": "1.1.2"
  }
}
